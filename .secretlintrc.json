{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "generic-env-secret",
            "pattern": "/^[A-Z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD|AUTH|PRIVATE)[A-Z0-9_]*=([A-Za-z0-9_\\-+/=]{20,})$/im"
          }
        ]
      }
    }
  ]
}
